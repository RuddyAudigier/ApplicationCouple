VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase "anon public" key (généralement ça commence par "eyJ...")
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Optionnel : en local (`npm run dev`), mets ici ton domaine Vercel pour que certains liens (ex: iCal)
# pointent sur le bon endpoint côté Vercel.
# Exemple : VITE_PUBLIC_BASE_URL=https://application-couple.vercel.app
VITE_PUBLIC_BASE_URL=https://application-couple.vercel.app

# Optionnel : base URL utilisée pour les redirections Supabase Auth (magic link).
# Par défaut c'est l'origin courant (ex: localhost en dev). Ne mets ceci que si tu sais ce que tu fais.
VITE_AUTH_REDIRECT_BASE_URL=

# Optionnel : email du/de la partenaire (pré-rempli pour “Poésie” → “À mon amour”).
VITE_PARTNER_EMAIL=
