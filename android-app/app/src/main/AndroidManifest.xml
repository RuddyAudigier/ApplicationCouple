<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />

  <application
    android:allowBackup="true"
    android:label="Nanamoureux"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:theme="@style/Theme.Material3.DayNight.NoActionBar">

    <!-- App unique: lance l’app web dans une WebView -->
    <activity
      android:name=".WebAppActivity"
      android:exported="true"
      android:launchMode="singleTask">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>

      <!-- Deep link: ouvre l’app quand Supabase redirige vers /auth/callback -->
      <intent-filter android:autoVerify="false">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data
          android:scheme="https"
          android:host="application-couple.vercel.app"
          android:pathPrefix="/auth/callback" />
      </intent-filter>

      <!-- Custom scheme: fiable pour ouvrir l’APK depuis le magic link -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data
          android:scheme="nanamoureux"
          android:host="auth"
          android:pathPrefix="/callback" />
      </intent-filter>
    </activity>

    <!-- Réglages: URL + token + emails -->
    <activity
      android:name=".SettingsActivity"
      android:exported="false" />

    <!-- Widget Poésie -->
    <receiver
      android:name=".PoetryWidgetProvider"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/poetry_widget_info" />
    </receiver>

  </application>
</manifest>
